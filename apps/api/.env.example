# Puerto del servidor API
PORT=4000

# Token para las rutas /admin (ver/cancelar turnos, exportar Excel).
# Elegí algo largo y random. Lo va a usar la pantalla de administración.
ADMIN_TOKEN=cambiame-por-un-token-largo-y-secreto

# --- Google Sheets (opcional, para la "agenda en Excel" sincronizada) ---
# Pasos en el README: crear cuenta de servicio en Google Cloud, compartir
# la planilla con su email, y pegar acá el email + la clave privada.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Opcional: para que el bot de WhatsApp responda preguntas libres con IA ---
ANTHROPIC_API_KEY=

# Carpeta donde se guarda la base SQLite (por defecto apps/api/data)
DATA_DIR=
